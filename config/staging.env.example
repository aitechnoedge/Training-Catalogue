# Public staging identity
APP_ENV=staging
APP_URL=https://training-catalogue-staging.vercel.app
ADMIN_ORIGIN=https://training-catalogue-staging.vercel.app
NON_PRODUCTION_DATA_ISOLATION_CONFIRMED=false

# Dedicated staging PostgreSQL/Supabase resources. Never copy production values.
DATABASE_URL=postgresql://staging-user:replace-me@staging-host:5432/staging-database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=require
LEADS_STORAGE_MODE=postgres
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_STORAGE_BUCKET=technoedge-media-staging

# Separate staging admin and scheduler credentials
ADMIN_OWNER_EMAIL=staging-owner@example.com
ADMIN_IP_HASH_SALT=replace-with-a-staging-only-random-secret
CRON_SECRET=replace-with-a-staging-only-random-secret
STAGING_BASIC_AUTH_USER=technoedge-staging
STAGING_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional. Leave unset to prevent staging from sending email.
# RESEND_API_KEY=
# ADMIN_EMAIL_FROM=TechnoEdge Staging <staging@example.com>
# ADMIN_NOTIFICATION_EMAIL=staging-inbox@example.com

# Do not configure INDEXNOW_KEY in staging.
