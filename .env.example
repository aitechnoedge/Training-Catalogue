# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Deployment identity. Vercel sets VERCEL_TARGET_ENV automatically; APP_ENV is
# kept explicit for local environment checks and should be `staging` in pre-prod.
APP_ENV="development"
# Staging and Preview database access remains locked until this is true. Set it
# only after every data store, auth key, storage bucket, and email credential is
# isolated from production.
NON_PRODUCTION_DATA_ISOLATION_CONFIRMED="false"

# PostgreSQL connection used only by the server and database scripts.
# Hosted providers normally require `?sslmode=require`.
DATABASE_URL="postgresql://catalogue_user:change-me@localhost:5432/training_catalogue"
DATABASE_POOL_MAX="10"
DATABASE_IMPORT_CHUNK_SIZE="100"
# Use `require` for encrypted pooler connections. For verified TLS, download
# the Supabase database certificate and set verify-full plus its local path.
DATABASE_SSL_MODE="require"
# DATABASE_SSL_ROOT_CERT="C:\path\to\prod-supabase.cer"

# API server. Vite proxies /api requests here during local development.
PORT="3001"
CATALOGUE_API_PROXY="http://localhost:3001"
SERVE_STATIC="false"

# Optional local-only Excel file for website enquiries. If omitted, the API
# writes to data/private/website-enquiries.xlsx in this repository.
# Local files are not durable on Vercel; this setting does not enable
# production enquiry storage.
# LEADS_WORKBOOK_PATH="C:\\private\\website-enquiries.xlsx"

# Enquiries use both Excel and PostgreSQL locally by default, and PostgreSQL
# on Vercel. Set to excel to keep local-only storage, or postgres to use only
# durable storage and the CRM outbox.
# Apply database/migrations/007_enquiries_crm_outbox.sql before enabling it.
# LEADS_STORAGE_MODE="hybrid"

# Audit identity recorded for command-line imports.
IMPORT_ACTOR="local-admin"

# Secure adminzz access. Create the single owner in Supabase Auth; public
# registration is not exposed by the website. Never expose service-role keys
# through a VITE_ variable.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="technoedge-media"
ADMIN_OWNER_EMAIL="owner@example.com"
ADMIN_ORIGIN="http://localhost:3000"
ADMIN_IP_HASH_SALT="replace-with-a-long-random-server-secret"
# Used by the Vercel scheduled publication request. Keep it server-only.
CRON_SECRET="replace-with-a-long-random-server-secret"

# Optional transactional email notifications.
RESEND_API_KEY=""
ADMIN_EMAIL_FROM="TechnoEdge Website <website@example.com>"
ADMIN_NOTIFICATION_EMAIL="owner@example.com"

# Public IndexNow verification key used by /api/indexnow-key and the
# post-deployment `npm run indexnow:submit` command.
# INDEXNOW_KEY="generate-a-random-8-to-128-character-key"

# Optional Google Tag Manager container. The browser loads it only after the
# visitor grants analytics consent through the site consent control.
# VITE_GTM_ID="GTM-XXXXXXX"
